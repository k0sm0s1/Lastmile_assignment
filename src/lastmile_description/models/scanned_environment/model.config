<?xml version="1.0"?>
<model>
  <name>scanned_environment</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>
  <description>
    Static collidable mesh reconstructed from map_ros_cloud.ply (real-world
    RGBD/SLAM scan of an indoor corridor intersection), via
    scripts/preprocess_cloud.py + scripts/cloud_to_mesh.py. 1 unit = 1 meter,
    floor at z=0. Visual and collision geometry both reference the same
    decimated mesh (~150k triangles) - see README for why collision isn't
    simplified to primitives.
  </description>
</model>
