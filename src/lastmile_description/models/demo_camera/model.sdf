<?xml version="1.0"?>
<sdf version="1.7">
  <!-- Kinematic, gravity-free camera that scripts/record_demo moves behind the
       robot every frame (via /gazebo/set_entity_state). Recording only. -->
  <model name="demo_camera">
    <static>false</static>
    <link name="link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <sensor name="chase_cam" type="camera">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <camera>
          <horizontal_fov>1.40</horizontal_fov>
          <image><width>960</width><height>540</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>40</far></clip>
        </camera>
        <plugin name="chase_cam_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/demo_cam</namespace></ros>
          <camera_name>chase</camera_name>
          <frame_name>demo_camera_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
